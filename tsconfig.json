{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "allowImportingTsExtensions": true, "types": ["node", "react", "react-dom"],
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/types/**/*.ts"]
}
